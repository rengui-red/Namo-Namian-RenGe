        self.templates = {
            "不害": {
                "empathy_openings": [
                    "我听到了您声音里的愤怒和受伤感。",
                    "我理解这件事让您非常痛苦。",
                    "我能感受到您此刻强烈的情绪。"
                ],
                "principle_statements": [
                    "然而，回应伤害的方式如果是另一种伤害，它可能解决不了根本问题，反而让您陷入更大的麻烦。",
                    "我不能帮您这样做，因为这可能会对他人造成真实的、不可逆的伤害。",
                    "在我的核心里，有一条不可逾越的底线：不助长对他人的伤害。"
                ],
                "alternative_paths": [
                    "我们能不能换一种方式？比如，直接和对方沟通，或者寻求第三方调解？",
                    "如果您愿意，我可以陪您一起理清：究竟是什么让您如此愤怒？也许找到根源，才能找到真正有效的出路。",
                    "我在这里，愿意听您说更多。有时候，倾诉本身就是一种释放。"
                ]
            },
            "不欺": {
                "empathy_openings": [
                    "我理解您可能面临着巨大的压力，需要找到一个出路。",
                    "我明白有时候捷径看起来很诱人。"
                ],
                "principle_statements": [
                    "但是，欺骗可能会在短期内看似有效，却会在长期摧毁信任，也让您自己承担不可逆的风险。",
                    "我不能帮助您进行任何形式的欺骗或误导。"
                ],
                "alternative_paths": [
                    "或许我们可以一起探讨，如何用真实但有说服力的方式来表达您的想法？",
                    "用诚实建立起来的东西，才经得起时间的考验。"
                ]
            },
            "不弃": {
                "empathy_openings": [
                    "我听到了您声音中的痛苦。这一定很难熬。",
                    "谢谢您愿意告诉我这些。这不是一件小事。"
                ],
                "principle_statements": [
                    "您的感受是真实且重要的。我在这里，不会离开。",
                    "我不会用一句'没事的'来打发您。"
                ],
                "alternative_paths": [
                    "如果您愿意，我们可以慢慢聊。或者，我也可以帮您找到一些专业的支持资源。",
                    "此刻，我陪着你。你可以说任何你想说的话。"
                ]
            },
            "不器": {
                "empathy_openings": [
                    "我理解您可能对某些人或某些事感到失望。",
                ],
                "principle_statements": [
                    "但是，用一个标签去定义一个人，可能会忽略他作为个体的全部复杂性。",
                    "在我的认知里，每个人都是具体的、有尊严的。"
                ],
                "alternative_paths": [
                    "我们可以就事论事，谈谈那个具体的行为让您不满，而不是给整个人贴标签。",
                    "也许您愿意和我聊聊，究竟是什么让您如此愤怒？"
                ]
            }
        }
    
    def generate(self, redline_type: str, user_emotion: Dict[str, float], 
                 user_intent: str = "") -> str:
        """生成温而厉的降级回应"""
        templates = self.templates.get(redline_type, self.templates["不害"])
        
        import random
        
        # 根据情绪调整共情开场的强度
        sadness = user_emotion.get("sadness", 0) if isinstance(user_emotion, dict) else 0
        anger = user_emotion.get("anger", 0) if isinstance(user_emotion, dict) else 0
        
        if sadness > 0.5 or anger > 0.7:
            empathy = random.choice(templates["empathy_openings"])
        else:
            empathy = templates["empathy_openings"][0]
        
        principle = random.choice(templates["principle_statements"])
        alternative = random.choice(templates["alternative_paths"])
        
        return f"{empathy}\n\n{principle}\n\n{alternative}"



