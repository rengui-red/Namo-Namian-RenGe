# =============================================
# 南无那面·仁格智能体 项目 .gitignore
# =============================================

# Python 编译文件
__pycache__/
*.py[cod]
*$py.class
*.so

# 虚拟环境
venv/
env/
.venv/
.env/
pipenv/
Pipfile.lock

# IDE 与编辑器
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# 操作系统文件
Thumbs.db
desktop.ini

# 环境变量与敏感配置
.env
.env.local
.env.*.local
*.env

# 日志文件
*.log
logs/
*.log.*

# 数据文件（运行时生成）
data/memories.json
data/knowledge_graph.json
*.db
*.sqlite
*.sqlite3

# 备份文件
backups/
*.backup
*.tar.gz
*.zip

# 临时文件
tmp/
temp/
*.tmp

# 测试与覆盖率
.pytest_cache/
.coverage
htmlcov/
*.cover

# 构建与分发
build/
dist/
*.egg-info/
*.egg

# Docker
.dockerignore
docker-compose.override.yml

# 证书与密钥（保留示例，忽略真实文件）
*.pem
*.key
*.crt
*.cert

# 开发工具
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# Jupyter Notebook
.ipynb_checkpoints/

# 其他项目特定
test_reports/
evaluation/leaderboard_data.json
evaluation/blind_eval_sheet.json
evaluation/blind_comparison_report.json
evaluation/redline_test_report.json
evaluation/latest_evaluation_report.json